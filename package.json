{
  "name": "dokube",
  "description": "Use DigitalOcean Kubernetes in GitHub Actions",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --license licenses.txt",
    "package": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:kind": "npm run build && node scripts/e2e.mjs --kind",
    "mock-api": "node test/mock-do-api.mjs",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matootie/dokube.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript",
    "DigitalOcean",
    "Kubernetes"
  ],
  "contributors": [
    {
      "name": "Mateja Lasan",
      "email": "mateja@lasan.ca",
      "url": "https://github.com/matootie"
    },
    {
      "name": "Stephen Edwards",
      "email": "sventi555@gmail.com",
      "url": "https://github.com/sventi555"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/matootie/dokube/issues"
  },
  "homepage": "https://github.com/matootie/dokube#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
